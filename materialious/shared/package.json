{
	"name": "@materialious/shared",
	"version": "1.0.0",
	"description": "Shared code between the Materialious web app and its Electron wrapper.",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./jsdom": {
			"types": "./dist/jsdom.d.ts",
			"default": "./dist/jsdom.js"
		},
		"./download": {
			"types": "./dist/download/index.d.ts",
			"default": "./dist/download/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"peerDependencies": {
		"bgutils-js": "^4.0.3",
		"ffmpeg-static": "^5.3.0",
		"fluent-ffmpeg": "^2.1.3",
		"googlevideo": "^4.1.1",
		"jsdom": "^28.0.0 || ^30.0.1",
		"youtubei.js": "^18.0.0"
	},
	"dependencies": {
		"@types/fluent-ffmpeg": "^2.1.27",
		"@types/jsdom": "^30.0.0"
	}
}
